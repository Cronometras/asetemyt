---
export const prerender = true;
import Layout from '../layouts/Layout.astro';
---

<Layout title="Comparador de Software de Cronometraje Industrial" description="Compara herramientas de software para cronometraje industrial, MTM, MOST, balanceo de líneas y Lean Manufacturing: plataforma, despliegue, dónde se guardan los datos, precio y funciones. Encuentra la mejor solución para tu empresa.">
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="mb-6 bg-amber-50 border-l-4 border-amber-400 p-4 rounded-r-lg">
      <p class="text-sm text-steel-600">
        <strong class="text-primary-800">Aviso editorial:</strong>
        Este comparador incluye proyectos del ecosistema de ASETEMYT
        (Cronometras, WorkSamp, Induly). La comparación se realiza
        conforme a los
        <a href="/criterios-inclusion" class="text-accent-600 hover:underline">criterios editoriales publicados</a>,
        no en función de la relación comercial. Consulta nuestra
        <a href="/politica-editorial" class="text-accent-600 hover:underline">política editorial</a>
        para más información.
      </p>
    </div>
    <div class="mb-10">
      <nav class="mb-4 text-sm text-steel-500">
        <a href="/" class="hover:text-accent-600" data-field="home">Inicio</a>
        <span class="mx-2">/</span>
        <span data-field="navCompare">Comparador</span>
      </nav>
      <h1 class="text-3xl md:text-4xl font-extrabold text-primary-800 mb-3" data-field="compareTitle">Comparador de Software de Cronometraje</h1>
      <p class="text-steel-500 text-lg" data-field="compareDesc">Selecciona hasta 3 herramientas y compara plataforma, despliegue, dónde se guardan los datos, precio y funciones.</p>
    </div>

    <!-- Selector -->
    <div class="bg-white rounded-xl shadow-md p-6 mb-8">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-4" id="selector-grid">
        <div>
          <label class="block text-sm font-medium text-steel-700 mb-1" data-field="tool1">Herramienta 1</label>
          <select id="select-1" class="w-full border border-steel-300 rounded-lg px-4 py-2.5 focus:ring-2 focus:ring-accent-500 outline-none bg-white">
            <option value="" data-field="selectTool">Seleccionar...</option>
          </select>
        </div>
        <div>
          <label class="block text-sm font-medium text-steel-700 mb-1" data-field="tool2">Herramienta 2</label>
          <select id="select-2" class="w-full border border-steel-300 rounded-lg px-4 py-2.5 focus:ring-2 focus:ring-accent-500 outline-none bg-white">
            <option value="" data-field="selectTool">Seleccionar...</option>
          </select>
        </div>
        <div>
          <label class="block text-sm font-medium text-steel-700 mb-1" data-field="tool3">Herramienta 3 (opcional)</label>
          <select id="select-3" class="w-full border border-steel-300 rounded-lg px-4 py-2.5 focus:ring-2 focus:ring-accent-500 outline-none bg-white">
            <option value="" data-field="selectTool">Seleccionar...</option>
          </select>
        </div>
      </div>
      <div class="flex flex-wrap gap-3">
        <button id="compare-btn" class="bg-accent-500 hover:bg-accent-600 text-white font-semibold px-6 py-2.5 rounded-lg transition-colors">
          <span data-field="compareBtn">Comparar</span>
        </button>
        <button id="clear-btn" class="bg-steel-100 hover:bg-steel-200 text-steel-700 font-semibold px-6 py-2.5 rounded-lg transition-colors">
          <span data-field="clearBtn">Limpiar</span>
        </button>
      </div>
    </div>

    <!-- Quick filters -->
    <div class="flex flex-wrap gap-2 mb-3" id="method-chips">
      <button class="filter-chip px-3 py-1.5 text-xs font-semibold rounded-full bg-accent-500 text-white cursor-pointer" data-filter="all" data-field="allTools">Todos</button>
    </div>
    <div class="flex flex-wrap items-center gap-3 mb-6">
      <select id="filter-cat" class="border border-steel-300 rounded-lg px-3 py-1.5 text-xs font-semibold bg-white text-steel-600 focus:ring-2 focus:ring-accent-500 outline-none">
        <option value="">Todas las categorías</option>
      </select>
      <input type="search" id="search-input" placeholder="Buscar herramienta..."
        class="border border-steel-300 rounded-lg px-3 py-1.5 text-xs focus:ring-2 focus:ring-accent-500 outline-none w-56" />
      <span id="grid-count" class="text-xs text-steel-400"></span>
    </div>

    <!-- Comparison Table -->
    <div id="comparison-result" class="hidden mb-8">
      <div class="overflow-x-auto">
        <table class="w-full bg-white rounded-xl shadow-md overflow-hidden">
          <thead id="comp-thead"></thead>
          <tbody id="comp-tbody"></tbody>
        </table>
      </div>
    </div>

    <!-- Software cards (all) -->
    <div id="software-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      <div class="text-center py-10 col-span-full">
        <div class="inline-block w-8 h-8 border-4 border-accent-500 border-t-transparent rounded-full animate-spin"></div>
      </div>
    </div>
  </section>

  <script>
    import { t, getLang, type Lang } from '../lib/firebase';

    let lang: Lang = getLang();
    let allSoftware: any[] = [];
    let activeMethod = 'all';

    const DASH = '—';

    const catLabels: Record<string, string> = {
      'medicion-tiempos': 'Medición de tiempos',
      'metodos-predeterminados': 'Métodos predeterminados',
      'ergonomia': 'Ergonomía',
      'oee-monitoreo': 'OEE y monitorización',
      'mes': 'MES',
      'erp': 'ERP',
      'wms': 'WMS',
      'cmms': 'CMMS',
      'aps': 'APS',
      'scada-iot': 'SCADA / IoT',
      'calidad-spc': 'Calidad / SPC',
      'calidad-qms': 'Calidad / QMS',
      'simulacion': 'Simulación',
      'mineria-procesos': 'Minería de procesos',
      'cad-plm': 'CAD / PLM',
      'formacion-lean': 'Formación Lean',
      'robotica-vision': 'Robótica y visión',
      'auditorias': 'Auditorias',
      'dms-gestion-diaria': 'DMS y gestión diaria',
      'tableros-visuales': 'Tableros visuales',
      'cmms-mantenimiento': 'CMMS y mantenimiento',
      'mejora-continua': 'Mejora continua',
      'almacenes-logistica': 'Almacén y logística',
      'despliegue-estrategico': 'Despliegue estratégico',
      'prevencion-prl': 'Prevención y PRL',
      'evaluacion-ergonomia': 'Evaluación ergonómica',
      'lms-gestion-jornada': 'Jornada y LMS',
      'kpi-estrategia': 'KPI y estrategia',
      'connected-worker': 'Operario conectado',
      'twi-habilidades': 'TWI y habilidades',
      };

    function tr(key: string): string {
      return t(key, lang);
    }

    function updateLabels() {
      document.querySelectorAll('[data-field]').forEach((el) => {
        const key = (el as HTMLElement).dataset.field!;
        const label = tr(key);
        if (label && label !== key) el.textContent = label;
      });
    }

    /** API → objeto plano con los parámetros comunes del comparador. */
    function normalize(raw: any): any {
      const p = raw.parametros || {};
      const pr = raw.pricing || {};
      return {
        slug: raw.slug,
        name: raw.nombre,
        categorias: raw.categorias || [],
        metodos: p.metodos || [],
        features: raw.funcionalidades || [],
        fabricante: raw.fabricante || '',
        descripcion: raw.descripcion || '',
        plataforma: p.plataforma || '',
        despliegue: p.despliegue || '',
        datos: p.datos || '',
        offline: p.offline || '',
        appMovil: p.app_movil || '',
        idiomas: p.idiomas || [],
        api: p.api || '',
        integraciones: p.integraciones || [],
        target: p.target || '',
        video: p.video || '',
        openSource: p.codigo_abierto || '',
        paisOrigen: p.pais_origen || '',
        licenciamiento: pr.modelo || '',
        precioDesde: pr.precio_desde || '',
        pruebaGratuita: pr.prueba_gratuita || '',
        pricingNotas: pr.notas || '',
      };
    }

    async function loadSoftware() {
      try {
        const res = await fetch('/api/directorio/software');
        if (!res.ok) throw new Error('HTTP ' + res.status);
        const data = await res.json();
        allSoftware = (data.software || []).map(normalize).sort((a: any, b: any) => a.name.localeCompare(b.name));

        const opts = allSoftware.map((s: any) => `<option value="${s.slug}">${s.name}</option>`).join('');
        ['select-1', 'select-2', 'select-3'].forEach(id => {
          const el = document.getElementById(id);
          if (el) el.innerHTML = `<option value="">${tr('selectTool')}</option>` + opts;
        });

        buildFilters();
        applyFilters();
      } catch (e) {
        console.error('Error loading software data:', e);
        const grid = document.getElementById('software-grid');
        if (grid) grid.innerHTML = `<p class="text-center text-steel-400 py-10 col-span-full">${tr('noSoftwareFound')}</p>`;
      }
    }

    function buildFilters() {
      // Chips de métodos: los 8 más frecuentes del catálogo
      const counts: Record<string, number> = {};
      allSoftware.forEach((s: any) => s.metodos.forEach((m: string) => { counts[m] = (counts[m] || 0) + 1; }));
      const top = Object.entries(counts).sort((a, b) => b[1] - a[1]).slice(0, 8).map(e => e[0]);

      const chips = document.getElementById('method-chips')!;
      chips.innerHTML = [`<button class="filter-chip px-3 py-1.5 text-xs font-semibold rounded-full bg-accent-500 text-white cursor-pointer" data-filter="all">${tr('allTools')}</button>`]
        .concat(top.map(m => `<button class="filter-chip px-3 py-1.5 text-xs font-semibold rounded-full bg-steel-100 text-steel-600 hover:bg-accent-100 hover:text-accent-700 transition-colors cursor-pointer" data-filter="${m.toLowerCase()}">${m}</button>`))
        .join('');

      chips.querySelectorAll('.filter-chip').forEach(chip => {
        chip.addEventListener('click', () => {
          activeMethod = (chip as HTMLElement).dataset.filter || 'all';
          chips.querySelectorAll('.filter-chip').forEach(c => {
            c.className = c === chip
              ? 'filter-chip px-3 py-1.5 text-xs font-semibold rounded-full bg-accent-500 text-white cursor-pointer'
              : 'filter-chip px-3 py-1.5 text-xs font-semibold rounded-full bg-steel-100 text-steel-600 hover:bg-accent-100 hover:text-accent-700 transition-colors cursor-pointer';
          });
          applyFilters();
        });
      });

      // Select de categorías (ámbito del producto)
      const cats = [...new Set(allSoftware.flatMap((s: any) => s.categorias))].sort();
      const catSel = document.getElementById('filter-cat') as HTMLSelectElement;
      if (catSel) {
        catSel.innerHTML = `<option value="">${lang === 'es' ? 'Todas las categorías' : 'All categories'}</option>` +
          cats.map(c => `<option value="${c}">${catLabels[c] || c}</option>`).join('');
        catSel.addEventListener('change', applyFilters);
      }

      const search = document.getElementById('search-input') as HTMLInputElement;
      search?.addEventListener('input', applyFilters);

      document.getElementById('compare-btn')?.addEventListener('click', compareSelected);
      document.getElementById('clear-btn')?.addEventListener('click', () => {
        ['select-1', 'select-2', 'select-3'].forEach(id => {
          const el = document.getElementById(id) as HTMLSelectElement;
          if (el) el.value = '';
        });
        document.getElementById('comparison-result')?.classList.add('hidden');
      });
    }

    function matches(s: any): boolean {
      const cat = (document.getElementById('filter-cat') as HTMLSelectElement)?.value || '';
      const q = ((document.getElementById('search-input') as HTMLInputElement)?.value || '').toLowerCase().trim();
      const methodOk = activeMethod === 'all' || s.metodos.some((m: string) => m.toLowerCase() === activeMethod);
      const catOk = !cat || s.categorias.includes(cat);
      const searchOk = !q || s.name.toLowerCase().includes(q)
        || s.metodos.some((m: string) => m.toLowerCase().includes(q))
        || s.categorias.some((c: string) => c.includes(q))
        || s.features.some((f: string) => f.toLowerCase().includes(q));
      return methodOk && catOk && searchOk;
    }

    function applyFilters() {
      const visible = allSoftware.filter(matches);
      renderGrid(visible);
      const countEl = document.getElementById('grid-count');
      if (countEl) countEl.textContent = `${visible.length} ${visible.length === 1 ? tr('result') : tr('results')}`;
    }

    function renderGrid(software: any[]) {
      const grid = document.getElementById('software-grid')!;
      if (software.length === 0) {
        grid.innerHTML = `<p class="text-center text-steel-400 py-10 col-span-full">${tr('noSoftwareFound')}</p>`;
        return;
      }

      grid.innerHTML = software.map((s: any) => `
        <div class="bg-white rounded-xl shadow-md p-5 hover:shadow-lg transition-all border border-steel-100 flex flex-col">
          <h3 class="font-bold text-primary-800 text-lg mb-2">
            <a href="/directorio/${s.slug}" class="hover:text-accent-600 transition-colors">${s.name}</a>
          </h3>
          <div class="flex flex-wrap gap-1.5 mb-3">
            ${s.metodos.map((m: string) => `<span class="text-xs bg-primary-50 text-primary-700 px-2 py-0.5 rounded font-medium">${m}</span>`).join('')}
          </div>
          <div class="space-y-1.5 text-sm text-steel-600 mb-3">
            <p><span class="font-medium text-steel-700">${tr('platform')}:</span> ${s.plataforma || DASH}</p>
            <p><span class="font-medium text-steel-700">${tr('dataStorage')}:</span> ${labelDeploy(s.datos)}</p>
            <p><span class="font-medium text-steel-700">${tr('license')}:</span> ${labelLicense(s.licenciamiento)}${s.precioDesde ? ` · ${s.precioDesde}` : ''}</p>
            <p><span class="font-medium text-steel-700">${tr('target')}:</span> ${labelTarget(s.target)}</p>
          </div>
          ${s.features.length ? `<p class="text-xs text-steel-500 line-clamp-2 mb-3">${s.features.slice(0, 4).join(' · ')}</p>` : ''}
          <div class="mt-auto flex flex-wrap gap-1.5 pt-1">
            ${s.pruebaGratuita === 'si' ? `<span class="text-xs bg-green-100 text-green-700 px-2 py-0.5 rounded font-medium">${tr('trialAvail')}</span>` : ''}
            ${s.video === 'si' ? `<span class="text-xs bg-blue-100 text-blue-700 px-2 py-0.5 rounded font-medium">${tr('videoAvail')}</span>` : ''}
            ${s.api === 'si' ? `<span class="text-xs bg-purple-100 text-purple-700 px-2 py-0.5 rounded font-medium">API</span>` : ''}
            ${s.offline === 'si' ? `<span class="text-xs bg-steel-100 text-steel-600 px-2 py-0.5 rounded font-medium">${tr('offline')}</span>` : ''}
          </div>
        </div>
      `).join('');
    }

    // ---- Traductores de valores enumerados ----
    function labelDeploy(v: string): string {
      if (v === 'nube') return tr('vCloud');
      if (v === 'local') return tr('vLocal');
      if (v === 'hibrido') return tr('vHybrid');
      return DASH;
    }
    function labelLicense(v: string): string {
      const map: Record<string, string> = {
        'suscripcion': tr('vSubscription'),
        'licencia-perpetua': tr('vPerpetual'),
        'gratuito': tr('vFree'),
        'freemium': tr('vFreemium'),
        'por-contacto': tr('vContact'),
      };
      return map[v] || DASH;
    }
    function labelTarget(v: string): string {
      const map: Record<string, string> = {
        'consultor': tr('vConsultant'),
        'pyme': tr('vSmb'),
        'gran-empresa': tr('vEnterprise'),
        'pyme-gran-empresa': tr('vSmbEnterprise'),
      };
      return map[v] || DASH;
    }
    function labelTrial(v: string): string {
      const map: Record<string, string> = { 'si': tr('yes'), 'no': tr('no'), 'demo-a-solicitud': tr('vTrialRequest') };
      return map[v] || DASH;
    }
    function labelSiNo(v: string): string {
      if (v === 'si') return tr('yes');
      if (v === 'no') return tr('no');
      if (v === 'parcial') return tr('vPartial');
      return DASH;
    }

    function compareSelected() {
      const slugs = ['select-1', 'select-2', 'select-3']
        .map(id => (document.getElementById(id) as HTMLSelectElement)?.value)
        .filter(Boolean);

      if (slugs.length < 2) {
        alert(tr('selectAtLeast'));
        return;
      }

      const selected = slugs.map(s => allSoftware.find(sw => sw.slug === s)).filter(Boolean);
      const resultEl = document.getElementById('comparison-result')!;
      const thead = document.getElementById('comp-thead')!;
      const tbody = document.getElementById('comp-tbody')!;

      const headerColors = ['bg-accent-500', 'bg-primary-600', 'bg-green-600'];
      thead.innerHTML = `<tr>
        <th class="text-left p-4 bg-steel-50 text-steel-700 font-semibold text-sm min-w-[140px]">${tr('characteristic')}</th>
        ${selected.map((s: any, i: number) => `<th class="p-4 ${headerColors[i]} text-white font-bold text-sm text-center">${s.name}</th>`).join('')}
      </tr>`;

      const rows = [
        { label: tr('platform'), value: (s: any) => s.plataforma || DASH },
        { label: tr('deployment'), value: (s: any) => labelDeploy(s.despliegue) },
        { label: tr('dataStorage'), value: (s: any) => labelDeploy(s.datos) },
        { label: tr('offline'), value: (s: any) => labelSiNo(s.offline) },
        { label: tr('mobileApp'), value: (s: any) => labelSiNo(s.appMovil) },
        { label: tr('license'), value: (s: any) => labelLicense(s.licenciamiento) },
        { label: tr('priceFrom'), value: (s: any) => s.precioDesde || DASH },
        { label: tr('trial'), value: (s: any) => labelTrial(s.pruebaGratuita) },
        { label: tr('languages'), value: (s: any) => (s.idiomas.length ? s.idiomas.join(', ') : DASH) },
        { label: tr('target'), value: (s: any) => labelTarget(s.target) },
        { label: tr('apiInt'), value: (s: any) => {
            const api = labelSiNo(s.api);
            return s.integraciones.length ? `${api} — ${s.integraciones.join(', ')}` : api;
          } },
        { label: tr('video'), value: (s: any) => labelSiNo(s.video) },
        { label: tr('openSource'), value: (s: any) => labelSiNo(s.openSource) },
        { label: tr('vendor'), value: (s: any) => [s.fabricante, s.paisOrigen].filter(Boolean).join(' · ') || DASH },
      ];

      tbody.innerHTML = rows.map(row => `
        <tr class="border-t border-steel-100">
          <td class="p-4 font-medium text-steel-700 text-sm">${row.label}</td>
          ${selected.map((s: any) => `<td class="p-4 text-center text-sm text-steel-600">${row.value(s)}</td>`).join('')}
        </tr>
      `).join('') + `
        <tr class="border-t border-steel-100">
          <td class="p-4 font-medium text-steel-700 text-sm">${tr('categoriesLabel')}</td>
          ${selected.map((s: any) => `<td class="p-4 text-center text-sm"><div class="flex flex-wrap gap-1 justify-center">${(s.categorias.length ? s.categorias.map((c: string) => catLabels[c] || c) : [DASH]).map((c: string) => `<span class="text-xs bg-steel-100 text-steel-600 px-2 py-0.5 rounded">${c}</span>`).join('')}</div></td>`).join('')}
        </tr>
        <tr class="border-t border-steel-100">
          <td class="p-4 font-medium text-steel-700 text-sm">${tr('methods')}</td>
          ${selected.map((s: any) => `<td class="p-4 text-center text-sm"><div class="flex flex-wrap gap-1 justify-center">${(s.metodos.length ? s.metodos : [DASH]).map((m: string) => `<span class="text-xs bg-primary-50 text-primary-700 px-2 py-0.5 rounded">${m}</span>`).join('')}</div></td>`).join('')}
        </tr>
        <tr class="border-t border-steel-100">
          <td class="p-4 font-medium text-steel-700 text-sm">${tr('keyFeatures')}</td>
          ${selected.map((s: any) => `<td class="p-4 text-sm"><ul class="text-xs text-steel-600 space-y-1">${(s.features.length ? s.features : [DASH]).map((f: string) => `<li class="flex items-start gap-1"><span class="text-accent-500 mt-0.5">•</span>${f}</li>`).join('')}</ul></td>`).join('')}
        </tr>
        <tr class="border-t border-steel-100">
          <td class="p-4 font-medium text-steel-700 text-sm">${tr('about')}</td>
          ${selected.map((s: any) => `<td class="p-4 text-sm text-steel-600">${s.descripcion || DASH}</td>`).join('')}
        </tr>
      `;

      resultEl.classList.remove('hidden');
      resultEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }

    window.addEventListener('langChange', ((e: CustomEvent) => {
      lang = e.detail;
      updateLabels();
      loadSoftware();
    }) as EventListener);

    loadSoftware();
  </script>
</Layout>
