<script>
  // Conmutador de idioma del sitio (ES/EN en cliente): intercambia el contenido
  // de la política sin crear una URL por idioma.
  const contentEl = document.getElementById('cookies-policy-content');
  const enTpl = document.getElementById('cookies-policy-en') as HTMLTemplateElement | null;
  const h1 = document.querySelector('h1[data-ck-policy="h1"]');
  if (contentEl && enTpl && h1) {
    const esHtml = contentEl.innerHTML;
    const applyLang = () => {
      const lang = localStorage.getItem('asetemyt-lang') === 'en' ? 'en' : 'es';
      contentEl.innerHTML = lang === 'en' ? enTpl.innerHTML : esHtml;
      h1.textContent = lang === 'en' ? 'Cookie Policy' : 'Política de Cookies';
    };
    window.addEventListener('langChange', applyLang);
    applyLang();
  }
</script>

