---
export const prerender = false;
import Layout from '../../../layouts/Layout.astro';
import { getDB, listConsultoresByEspecialidad } from '../../../lib/d1';

const db = getDB(Astro.locals);
const slugParam = Astro.params.slug || '';

// Display titles (extend with more as the catalogue grows)
const TITLES: Record<string, string> = {
  'lean': 'Lean Manufacturing',
  'ingenieria-industrial': 'Ingeniería Industrial',
  'formacion-industrial': 'Formación Industrial',
  'cronometraje': 'Cronometraje Industrial',
  'consultoria-industrial': 'Consultoría Industrial',
  'productividad': 'Productividad Industrial',
  'mejora-continua': 'Mejora Continua',
  'calidad': 'Calidad Industrial',
  'oee': 'OEE (Overall Equipment Effectiveness)',
  'ingenieria-de-metodos': 'Ingeniería de Métodos',
  'ergonomia': 'Ergonomía Industrial',
  'tpm': 'TPM (Mantenimiento Productivo Total)',
  'industria-4-0': 'Industria 4.0',
  'planificacion': 'Planificación de la Producción',
  'gestion-de-produccion': 'Gestión de Producción',
  'optimizacion-procesos': 'Optimización de Procesos',
  'automatizacion-industrial': 'Automatización Industrial',
  'consultoria-lean': 'Consultoría Lean',
};

const slugNorm = slugParam.toLowerCase();
const nombre = TITLES[slugNorm] || slugParam.replace(/-/g, ' ');

const consultores = await listConsultoresByEspecialidad(db, slugNorm);

const title = `Consultores y empresas de ${nombre} en España | Asetemyt`;
const description = `${consultores.length} profesionales y empresas especializadas en ${nombre.toLowerCase()} en el directorio Asetemyt. Encuentra consultores, freelance y proveedores para tu proyecto.`;
const canonical = `https://asetemyt.com/directorio/especialidad/${slugNorm}`;

const collectionSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": `Profesionales de ${nombre} en España`,
  "description": description,
  "url": canonical,
  "numberOfItems": consultores.length,
  "itemListElement": consultores.slice(0, 20).map((c, i) => ({
    "@type": "ListItem",
    "position": i + 1,
    "url": `https://asetemyt.com/directorio/${c.slug}`,
    "name": c.nombre,
  })),
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Inicio", "item": "https://asetemyt.com/" },
    { "@type": "ListItem", "position": 2, "name": "Directorio", "item": "https://asetemyt.com/directorio" },
    { "@type": "ListItem", "position": 3, "name": "Especialidades", "item": "https://asetemyt.com/directorio/especialidades" },
    { "@type": "ListItem", "position": 4, "name": nombre, "item": canonical },
  ],
};

const byTipo = {
  empresa: consultores.filter(c => c.tipo === 'empresa'),
  consultor: consultores.filter(c => c.tipo !== 'empresa'),
};
---

<Layout title={title} description={description} canonical={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(collectionSchema)} slot="head" />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} slot="head" />

  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <nav class="text-sm text-steel-500 mb-6" aria-label="Breadcrumb">
      <ol class="flex flex-wrap items-center gap-1">
        <li><a href="/" class="hover:text-steel-700">Inicio</a></li>
        <li aria-hidden="true">›</li>
        <li><a href="/directorio" class="hover:text-steel-700">Directorio</a></li>
        <li aria-hidden="true">›</li>
        <li><a href="/directorio/especialidades" class="hover:text-steel-700">Especialidades</a></li>
        <li aria-hidden="true">›</li>
        <li class="text-steel-900 font-medium">{nombre}</li>
      </ol>
    </nav>

    <header class="mb-10">
      <h1 class="text-3xl md:text-4xl font-bold text-steel-900 mb-3">
        Consultores y empresas de {nombre}
      </h1>
      <p class="text-lg text-steel-600">
        {consultores.length} profesionales y empresas especializadas en {nombre.toLowerCase()} en España. Directorio verificado de consultores, empresas y freelance.
      </p>
    </header>

    {consultores.length > 0 && (
      <div class="flex gap-2 mb-8 text-sm">
        <span class="px-3 py-1 rounded-full bg-steel-100 text-steel-700">
          Todos ({consultores.length})
        </span>
        {byTipo.empresa.length > 0 && (
          <span class="px-3 py-1 rounded-full bg-blue-50 text-blue-700">
            Empresas ({byTipo.empresa.length})
          </span>
        )}
        {byTipo.consultor.length > 0 && (
          <span class="px-3 py-1 rounded-full bg-green-50 text-green-700">
            Consultores ({byTipo.consultor.length})
          </span>
        )}
      </div>
    )}

    {consultores.length === 0 ? (
      <div class="bg-steel-50 rounded-xl p-12 text-center">
        <p class="text-steel-600 mb-4">No hay fichas registradas con esta especialidad todavía.</p>
        <a href="/anadir" class="inline-block px-6 py-3 bg-brand-600 text-white rounded-lg hover:bg-brand-700">
          Añadir mi empresa
        </a>
      </div>
    ) : (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {consultores.map((c) => (
          <a
            href={`/directorio/${c.slug}`}
            class="bg-white rounded-xl shadow-md hover:shadow-lg transition-shadow p-6 block"
          >
            <div class="flex items-start gap-4 mb-4">
              {c.logo ? (
                <img src={c.logo} alt={`Logo ${c.nombre}`} class="w-14 h-14 object-contain rounded-lg bg-steel-50" loading="lazy" />
              ) : (
                <div class="w-14 h-14 bg-steel-100 rounded-lg flex items-center justify-center text-steel-400 text-xl font-bold">
                  {c.nombre.charAt(0)}
                </div>
              )}
              <div class="flex-1 min-w-0">
                <h2 class="text-lg font-semibold text-steel-900 truncate" title={c.nombre}>
                  {c.nombre}
                </h2>
                <span class={`inline-block mt-1 px-2 py-0.5 text-xs rounded-full ${
                  c.tipo === 'empresa' ? 'bg-blue-100 text-blue-700' : 'bg-green-100 text-green-700'
                }`}>
                  {c.tipo || 'consultor'}
                </span>
              </div>
            </div>
            {c.descripcion && (
              <p class="text-sm text-steel-600 line-clamp-3 mb-3">{c.descripcion}</p>
            )}
            {c.ubicacion && c.ubicacion.ciudad && (
              <p class="text-xs text-steel-500 mt-2">{c.ubicacion.ciudad}{c.ubicacion.pais ? `, ${c.ubicacion.pais}` : ''}</p>
            )}
          </a>
        ))}
      </div>
    )}

    <div class="mt-12 bg-gradient-to-r from-brand-50 to-brand-100 rounded-xl p-8 text-center">
      <h3 class="text-xl font-semibold text-steel-900 mb-2">¿Ofreces servicios de {nombre}?</h3>
      <p class="text-steel-600 mb-4">Añade tu ficha al directorio y recibe consultas de empresas que buscan tu especialidad.</p>
      <a href="/anadir" class="inline-block px-6 py-3 bg-brand-600 text-white rounded-lg hover:bg-brand-700 font-medium">
        Añadir mi empresa gratis
      </a>
    </div>
  </section>
</Layout>
