---
  export const prerender = false;
  import Layout from '../../layouts/Layout.astro';
  import ReviewsSection from '../../components/ReviewsSection.astro';
  import RequestQuote from '../../components/RequestQuote.astro';
  import Certificate from '../../components/Certificate.astro';
  import PartnerBadge from '../../components/PartnerBadge.astro';
  import CasesSection from '../../components/CasesSection.astro';
  import ContactSection from '../../components/ContactSection.astro';
  import { getDB, getConsultorBySlug, getSoftwareBySlug } from '../../lib/d1';

const db = getDB(Astro.locals);
const slug = Astro.params.slug || '';
const entry = await getConsultorBySlug(db, slug) || await getSoftwareBySlug(db, slug);

if (!entry) {
  return Astro.redirect('/directorio');
}

const tipoColors: Record<string, string> = {
  empresa: 'bg-blue-100 text-blue-700',
  consultor: 'bg-green-100 text-green-700',
  software: 'bg-purple-100 text-purple-700',
};

// Ficha de software: parámetros comparables (migración 0004) y vocabulario de
// valores enumerados — docs/parametros-comparador-software.md
const isSoftware = entry.seccion === 'software';
const P: any = isSoftware ? (entry.parametros || {}) : {};
const PR: any = isSoftware ? (entry.pricing || {}) : {};
const DASH = '—';
const deployKeys: Record<string, string> = { nube: 'vCloud', local: 'vLocal', hibrido: 'vHybrid' };
const boolKeys: Record<string, string> = { si: 'yes', no: 'no', parcial: 'vPartial' };
const licenseKeys: Record<string, string> = {
  suscripcion: 'vSubscription', 'licencia-perpetua': 'vPerpetual', gratuito: 'vFree',
  freemium: 'vFreemium', 'por-contacto': 'vContact',
};
const targetKeys: Record<string, string> = {
  consultor: 'vConsultant', pyme: 'vSmb', 'gran-empresa': 'vEnterprise', 'pyme-gran-empresa': 'vSmbEnterprise',
};
const trialKeys: Record<string, string> = { si: 'yes', no: 'no', 'demo-a-solicitud': 'vTrialRequest' };

function keyOr(value: string, map: Record<string, string>): string | null {
  return (value && map[value]) || null;
}
function rawOr(value: string): string {
  return (value && String(value)) || DASH;
}

const catLabels: Record<string, string> = {
  'medicion-tiempos': 'Medición de tiempos',
  'metodos-predeterminados': 'Métodos predeterminados',
  'ergonomia': 'Ergonomía',
  'oee-monitoreo': 'OEE y monitorización',
  'mes': 'MES',
  'erp': 'ERP',
  'wms': 'WMS',
  'cmms': 'CMMS',
  'aps': 'APS',
  'scada-iot': 'SCADA / IoT',
  'calidad-spc': 'Calidad / SPC',
  'calidad-qms': 'Calidad / QMS',
  'simulacion': 'Simulación',
  'mineria-procesos': 'Minería de procesos',
  'cad-plm': 'CAD / PLM',
  'formacion-lean': 'Formación Lean',
  'robotica-vision': 'Robótica y visión',
  'auditorias': 'Auditorias',
  'dms-gestion-diaria': 'DMS y gestión diaria',
  'tableros-visuales': 'Tableros visuales',
  'cmms-mantenimiento': 'CMMS y mantenimiento',
  'mejora-continua': 'Mejora continua',
  'almacenes-logistica': 'Almacén y logística',
  'despliegue-estrategico': 'Despliegue estratégico',
  'prevencion-prl': 'Prevención y PRL',
  'evaluacion-ergonomia': 'Evaluación ergonómica',
  'lms-gestion-jornada': 'Jornada y LMS',
  'kpi-estrategia': 'KPI y estrategia',
  'connected-worker': 'Operario conectado',
  'twi-habilidades': 'TWI y habilidades',
};

type TechRow = { label: string; labelKey: string; value: string; valueKey: string | null };
const techRows: TechRow[] = isSoftware ? [
  { label: 'Plataforma', labelKey: 'platform', value: rawOr(P.plataforma), valueKey: null },
  { label: 'Despliegue', labelKey: 'deployment', value: rawOr(P.despliegue), valueKey: keyOr(P.despliegue, deployKeys) },
  { label: 'Datos', labelKey: 'dataStorage', value: rawOr(P.datos), valueKey: keyOr(P.datos, deployKeys) },
  { label: 'Sin conexión', labelKey: 'offline', value: rawOr(P.offline), valueKey: keyOr(P.offline, boolKeys) },
  { label: 'App móvil', labelKey: 'mobileApp', value: rawOr(P.app_movil), valueKey: keyOr(P.app_movil, boolKeys) },
  { label: 'Licenciamiento', labelKey: 'license', value: rawOr(PR.modelo), valueKey: keyOr(PR.modelo, licenseKeys) },
  { label: 'Precio desde', labelKey: 'priceFrom', value: rawOr(PR.precio_desde), valueKey: null },
  { label: 'Prueba gratuita', labelKey: 'trial', value: rawOr(PR.prueba_gratuita), valueKey: keyOr(PR.prueba_gratuita, trialKeys) },
  { label: 'Idiomas', labelKey: 'languages', value: (P.idiomas || []).length ? (P.idiomas as string[]).join(', ') : DASH, valueKey: null },
  { label: 'Empresa objetivo', labelKey: 'target', value: rawOr(P.target), valueKey: keyOr(P.target, targetKeys) },
  { label: 'API', labelKey: 'apiInt', value: rawOr(P.api), valueKey: keyOr(P.api, boolKeys) },
  { label: 'Vídeo', labelKey: 'video', value: rawOr(P.video), valueKey: keyOr(P.video, boolKeys) },
  { label: 'Código abierto', labelKey: 'openSource', value: rawOr(P.codigo_abierto), valueKey: keyOr(P.codigo_abierto, boolKeys) },
  { label: 'Fabricante', labelKey: 'vendor', value: [entry.fabricante, P.pais_origen].filter(Boolean).join(' · ') || DASH, valueKey: null },
].filter((r) => r.value !== DASH) : [];

// JSON-LD (build-time) — schema.org BreadcrumbList
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Inicio", "item": "https://asetemyt.com/" },
    { "@type": "ListItem", "position": 2, "name": "Directorio", "item": "https://asetemyt.com/directorio" },
    { "@type": "ListItem", "position": 3, "name": entry.nombre, "item": `https://asetemyt.com/directorio/${entry.slug}/` },
  ],
};

// JSON-LD (build-time) — schema.org Organization | Person
const entitySchema: Record<string, unknown> = {
  "@context": "https://schema.org",
  "@type": isSoftware ? 'SoftwareApplication' : (entry.tipo === 'empresa' ? 'Organization' : 'Person'),
  "name": entry.nombre,
  "url": `https://asetemyt.com/directorio/${entry.slug}/`,
  "description": entry.descripcion || '',
};
if (entry.tipo === 'empresa') {
  entitySchema['@id'] = `https://asetemyt.com/directorio/${entry.slug}/#organization`;
} else {
  entitySchema['@id'] = `https://asetemyt.com/directorio/${entry.slug}/#person`;
}
---

<Layout title={entry.nombre} description={entry.descripcion} ogType="profile">
  <!-- BreadcrumbList structured data -->
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <!-- Entity (Organization | Person) structured data -->
  <script type="application/ld+json" set:html={JSON.stringify(entitySchema)} />
  <section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <!-- Breadcrumb -->
    <nav class="mb-8">
      <a href="/directorio" onclick="event.preventDefault(); window.history.length > 1 ? window.history.back() : window.location.href='/directorio'" class="text-accent-600 hover:text-accent-700 text-sm font-medium flex items-center gap-1 cursor-pointer">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
        </svg>
        Volver
      </a>
    </nav>

    <!-- Profile Header -->
    <div class="bg-white rounded-2xl shadow-lg overflow-hidden mb-8">
      <div class="bg-gradient-to-r from-primary-800 to-primary-900 p-8">
        <div class="flex items-center gap-6">
          {entry.logo ? (
            <img src={entry.logo} alt={entry.nombre} class="w-24 h-24 rounded-xl object-cover shadow-lg border-2 border-white/20" />
          ) : (
            <div class="w-24 h-24 rounded-xl bg-accent-500 flex items-center justify-center text-white font-bold text-3xl shadow-lg">
              {entry.nombre?.[0]?.toUpperCase() || '?'}
            </div>
          )}
          <div>
            <div class="flex items-center gap-3 mb-2">
              <h1 class="text-3xl font-extrabold text-white">{entry.nombre}</h1>
              {entry.verificado && (
                <span class="bg-green-500 text-white text-xs font-bold px-2 py-1 rounded-full flex items-center gap-1">
                  <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                  </svg>
                  Verificado
                </span>
              )}
              <PartnerBadge tools={entry.herramientas || []} />
            </div>
            <span class={`inline-block text-sm font-semibold px-3 py-1 rounded-full ${isSoftware ? tipoColors.software : (tipoColors[entry.tipo] || 'bg-steel-100 text-steel-600')}`}>
              <span data-field={isSoftware ? 'softwareBadge' : (entry.tipo || 'sinTipo')}>{isSoftware ? 'Software' : (entry.tipo === 'empresa' ? 'Empresa' : 'Consultor')}</span>
            </span>
          </div>
        </div>
      </div>

      <div class="p-8">
        <!-- Description -->
        {entry.descripcion && (
          <div class="mb-8">
            <h2 class="text-lg font-bold text-primary-800 mb-3" data-field="about">Acerca de</h2>
            <p class="text-steel-600 leading-relaxed">{entry.descripcion}</p>
          </div>
        )}

        {/* Ficha técnica (software): parámetros comunes del comparador */}
        {isSoftware && (
          <div class="mb-8">
            <h2 class="text-lg font-bold text-primary-800 mb-3" data-field="techSheet">Ficha técnica</h2>

            {entry.categorias?.length > 0 && (
              <div class="mb-4">
                <h3 class="text-sm font-semibold text-steel-700 mb-2" data-field="categoriesLabel">Categorías</h3>
                <div class="flex flex-wrap gap-2">
                  {entry.categorias.map((c: string) => (
                    <span class="bg-steel-100 text-steel-700 px-3 py-1 rounded-lg text-sm font-medium">{catLabels[c] || c}</span>
                  ))}
                </div>
              </div>
            )}

            {P.metodos?.length > 0 && (
              <div class="mb-4">
                <h3 class="text-sm font-semibold text-steel-700 mb-2" data-field="methodsLabel">Métodos</h3>
                <div class="flex flex-wrap gap-2">
                  {P.metodos.map((m: string) => (
                    <span class="bg-primary-50 text-primary-700 px-3 py-1 rounded-lg text-sm font-medium">{m}</span>
                  ))}
                </div>
              </div>
            )}

            <dl class="grid grid-cols-1 sm:grid-cols-2 gap-x-8 gap-y-3">
              {techRows.map((row) => (
                <div class="flex items-baseline justify-between gap-3 border-b border-steel-100 pb-2">
                  <dt class="text-sm font-medium text-steel-500 shrink-0" data-field={row.labelKey}>{row.label}</dt>
                  <dd class="text-sm text-steel-700 text-right" data-field={row.valueKey || undefined}>{row.value}</dd>
                </div>
              ))}
            </dl>

            {entry.funcionalidades?.length > 0 && (
              <div class="mt-5">
                <h3 class="text-sm font-semibold text-steel-700 mb-2" data-field="keyFeatures">Funciones clave</h3>
                <ul class="grid grid-cols-1 md:grid-cols-2 gap-2">
                  {entry.funcionalidades.map((f: string) => (
                    <li class="flex items-start gap-2 text-steel-600">
                      <svg class="w-5 h-5 text-accent-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                      </svg>
                      {f}
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </div>
        )}

        <!-- Especialidades -->
        {entry.especialidades?.length > 0 && (
          <div class="mb-8">
            <h2 class="text-lg font-bold text-primary-800 mb-3" data-field="specialtiesLabel">Especialidades</h2>
            <div class="flex flex-wrap gap-2">
              {entry.especialidades.map((esp: string) => (
                <a
                  href={`/directorio?especialidad=${esp}`}
                  class="bg-primary-50 text-primary-700 px-4 py-2 rounded-lg text-sm font-medium hover:bg-primary-100 transition-colors"
                >
                  <span data-field={esp}>{esp.toUpperCase()}</span>
                </a>
              ))}
            </div>
          </div>
        )}

        <!-- Servicios -->
        {entry.servicios?.length > 0 && (
          <div class="mb-8">
            <h2 class="text-lg font-bold text-primary-800 mb-3" data-field="servicesLabel">Servicios</h2>
            <ul class="grid grid-cols-1 md:grid-cols-2 gap-2">
              {entry.servicios.map((servicio: string) => (
                <li class="flex items-center gap-2 text-steel-600">
                  <svg class="w-5 h-5 text-accent-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                  </svg>
                  {servicio}
                </li>
              ))}
            </ul>
          </div>
        )}

        <!-- Ubicación -->
        {entry.ubicacion && (
          <div class="mb-8">
            <h2 class="text-lg font-bold text-primary-800 mb-3" data-field="locationLabel">Ubicación</h2>
            <div class="flex items-start gap-3 text-steel-600">
              <svg class="w-5 h-5 text-steel-400 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
              <div>
                {entry.ubicacion.direccion && <p>{entry.ubicacion.direccion}</p>}
                <p class="flex flex-wrap items-center gap-1">
                  {entry.ubicacion.ciudad && (
                    <a href={`/directorio?ciudad=${encodeURIComponent(entry.ubicacion.ciudad)}`}
                       class="text-accent-600 hover:text-accent-800 hover:underline font-medium transition-colors">
                      {entry.ubicacion.ciudad}
                    </a>
                  )}
                  {entry.ubicacion.ciudad && entry.ubicacion.provincia && <span class="text-steel-400">,</span>}
                  {entry.ubicacion.provincia && (
                    <a href={`/directorio?provincia=${encodeURIComponent(entry.ubicacion.provincia)}`}
                       class="text-accent-600 hover:text-accent-800 hover:underline font-medium transition-colors">
                      {entry.ubicacion.provincia}
                    </a>
                  )}
                  {entry.ubicacion.pais && (
                    <>
                      <span class="text-steel-400">·</span>
                      <span>{entry.ubicacion.pais}</span>
                    </>
                  )}
                </p>
              </div>
            </div>
          </div>
        )}

        <!-- Contacto — Astro island: SSR placeholder + client hydration -->
        <div>
          <h2 class="text-lg font-bold text-primary-800 mb-3" data-field="contactLabel">Contacto</h2>
          <ContactSection slug={entry.slug} />
        </div>
      </div>
    </div>

    <!-- Reclamar ficha CTA (not verified) -->
    {!entry.verificado && (
      <div class="mt-8 p-6 bg-gradient-to-r from-accent-50 to-accent-100 rounded-xl border border-accent-200">
        <div class="flex items-start gap-4">
          <div class="w-10 h-10 bg-accent-500 rounded-lg flex items-center justify-center flex-shrink-0">
            <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
            </svg>
          </div>
          <div>
            <h3 class="font-bold text-primary-900" data-field="ownerQuestion">¿Eres el propietario de esta ficha?</h3>
            <p class="text-sm text-steel-600 mt-1 mb-3" data-field="ownerDesc">Verifícala para editar los datos y mostrar el badge de confianza. 50€/año.</p>
            <a href={`/reclamar/${entry.slug}`}
              class="inline-block bg-accent-500 hover:bg-accent-600 text-white font-bold px-5 py-2.5 rounded-lg text-sm transition-colors">
              <span data-field="claimFicha">Reclamar esta ficha →</span>
            </a>
          </div>
        </div>
      </div>
    )}

    <!-- Editar ficha CTA (verified — shown to owner only via client-side check) -->
    {entry.verificado && (
      <div id="ownerEditCTA" class="hidden mt-8 p-6 bg-gradient-to-r from-green-50 to-green-100 rounded-xl border border-green-200">
        <div class="flex items-start gap-4">
          <div class="w-10 h-10 bg-green-500 rounded-lg flex items-center justify-center flex-shrink-0">
            <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
            </svg>
          </div>
          <div>
            <h3 class="font-bold text-primary-900" data-field="verifiedFicha">Tu ficha verificada</h3>
            <p class="text-sm text-steel-600 mt-1 mb-3" data-field="editFichaDesc">Edita los datos de tu ficha para mantenerla actualizada.</p>
            <a href={`/editar/${entry.slug}`}
              class="inline-block bg-green-600 hover:bg-green-700 text-white font-bold px-5 py-2.5 rounded-lg text-sm transition-colors">
              <span data-field="editFicha">Editar ficha →</span>
            </a>
          </div>
        </div>
      </div>
    )}
  </section>
  {/* AggregateRating schema.org — injected dynamically after reviews load */}
  <script is:inline define:vars={{ entrySlug: entry.slug, entryName: entry.nombre }}>
    (async function() {
      try {
        var res = await fetch('/api/reviews/get?slug=' + encodeURIComponent(entrySlug));
        if (!res.ok) return;
        var data = await res.json();
        if (data.aggregateRating && data.aggregateRating.reviewCount > 0) {
          var schema = {
            "@context": "https://schema.org",
            "@type": "LocalBusiness",
            "name": entryName,
            "url": "https://asetemyt.com/directorio/" + entrySlug,
            "aggregateRating": {
              "@type": "AggregateRating",
              "ratingValue": String(data.aggregateRating.avgRating),
              "bestRating": "5",
              "worstRating": "1",
              "ratingCount": String(data.aggregateRating.reviewCount)
            }
          };
          var script = document.createElement('script');
          script.type = 'application/ld+json';
          script.textContent = JSON.stringify(schema);
          document.head.appendChild(script);
        }
      } catch(e) { console.error('AggregateRating schema error:', e); }
    })();
  </script>

  {/* Reviews */}
  <section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 pb-12">
    {/* Lead Gen: Solicitar Presupuesto */}
    <div class="pb-4">
      <RequestQuote slug={entry.slug} entryName={entry.nombre} services={entry.servicios || []} />
    </div>
    <ReviewsSection slug={entry.slug} entryName={entry.nombre} />
    <CasesSection slug={entry.slug} entryName={entry.nombre} isOwner={false} />
  </section>

  {/* Certificate for verified members */}
  {entry.verificado && (
    <section id="ownerCertSection" class="hidden max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 pb-12">
      <Certificate entryName={entry.nombre} entrySlug={entry.slug} tipo={entry.tipo} />
    </section>
  )}

  {/* i18n: translate data-field labels on ficha pages */}
  <script>
    import { t, getLang, type Lang } from '../../lib/firebase';

    let lang: Lang = getLang();

    function updateLabels() {
      document.querySelectorAll('[data-field]').forEach((el) => {
        const key = (el as HTMLElement).dataset.field!;
        const label = t(key, lang);
        if (label && label !== key) el.textContent = label;
      });
    }

    window.addEventListener('langChange', ((e: CustomEvent) => {
      lang = e.detail;
      updateLabels();
    }) as EventListener);

    updateLabels();
  </script>

  {/* Client-side: show edit CTA to the owner of this verified ficha */}
  {entry.verificado && (
    <script>
      import { onAuthStateChanged, auth, authFetch } from '../../lib/auth';

      const slug = window.location.pathname.split('/').filter(Boolean).pop();

      onAuthStateChanged(auth, async (user) => {
        if (!user || !slug) return;
        try {
          const resp = await authFetch('/api/user/data');
          if (!resp.ok) return;
          const data = await resp.json();
          const isOwner = data.fichas?.some((f: any) => f.slug === slug);
          if (isOwner) {
            document.getElementById('ownerEditCTA')?.classList.remove('hidden');
            document.getElementById('ownerCertSection')?.classList.remove('hidden');
          }
        } catch (e) { console.error('Owner auth check failed:', e); }
      });
    </script>
  )}
</Layout>
