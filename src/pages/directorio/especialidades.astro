---
export const prerender = false;
import Layout from '../../layouts/Layout.astro';
import { getDB, getEspecialidadesWithCounts } from '../../lib/d1';

const db = getDB(Astro.locals);
const all = await getEspecialidadesWithCounts(db);

// Filter to SEO-relevant ones (count >= 10)
const seo = all.filter(e => e.count >= 10);
// Show the full list at /directorio/especialidades; just less prominent below

const title = 'Directorio por especialidad | Asetemyt';
const description = `Profesionales del cronometraje industrial, MTM, OEE, Lean y mejora continua, organizados por especialidad. Encuentra consultores y empresas por disciplina.`;
const canonical = 'https://asetemyt.com/directorio/especialidades';

const TITLES: Record<string, string> = {
  'lean': 'Lean Manufacturing',
  'ingenieria-industrial': 'Ingeniería Industrial',
  'formacion-industrial': 'Formación Industrial',
  'cronometraje': 'Cronometraje Industrial',
  'consultoria-industrial': 'Consultoría Industrial',
  'productividad': 'Productividad Industrial',
  'mejora-continua': 'Mejora Continua',
  'calidad': 'Calidad Industrial',
  'oee': 'OEE (Overall Equipment Effectiveness)',
  'ingenieria-de-metodos': 'Ingeniería de Métodos',
  'ergonomia': 'Ergonomía Industrial',
  'tpm': 'TPM (Mantenimiento Productivo Total)',
  'industria-4-0': 'Industria 4.0',
  'planificacion': 'Planificación de la Producción',
  'gestion-de-produccion': 'Gestión de Producción',
  'optimizacion-procesos': 'Optimización de Procesos',
  'automatizacion-industrial': 'Automatización Industrial',
  'consultoria-lean': 'Consultoría Lean',
};
---

<Layout title={title} description={description} canonical={canonical}>
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <nav class="text-sm text-steel-500 mb-6" aria-label="Breadcrumb">
      <ol class="flex flex-wrap items-center gap-1">
        <li><a href="/" class="hover:text-steel-700">Inicio</a></li>
        <li aria-hidden="true">›</li>
        <li><a href="/directorio" class="hover:text-steel-700">Directorio</a></li>
        <li aria-hidden="true">›</li>
        <li class="text-steel-900 font-medium">Especialidades</li>
      </ol>
    </nav>

    <header class="mb-10">
      <h1 class="text-3xl md:text-4xl font-bold text-steel-900 mb-3">
        Directorio por especialidad
      </h1>
      <p class="text-lg text-steel-600">
        {all.length} especialidades representadas por {all.reduce((a, e) => a + e.count, 0)} profesionales y empresas del sector industrial.
      </p>
    </header>

    <section class="mb-12">
      <h2 class="text-xl font-semibold text-steel-800 mb-4">Especialidades principales</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {seo.map((e) => (
          <a
            href={`/directorio/especialidad/${e.slug}`}
            class="block p-5 bg-white rounded-xl border border-steel-200 hover:border-brand-500 hover:shadow-md transition-all"
          >
            <div class="font-semibold text-steel-900">
              {TITLES[e.slug] || e.nombre}
            </div>
            <div class="text-sm text-steel-500 mt-1">
              {e.count} {e.count === 1 ? 'profesional' : 'profesionales'}
            </div>
          </a>
        ))}
      </div>
    </section>

    {all.length > seo.length && (
      <section class="mb-12">
        <h2 class="text-xl font-semibold text-steel-800 mb-4">Otras especialidades</h2>
        <div class="flex flex-wrap gap-2">
          {all.filter(e => e.count < 10 && e.count >= 1).map((e) => (
            <a
              href={`/directorio/especialidad/${e.slug}`}
              class="px-3 py-1.5 text-sm bg-steel-100 hover:bg-brand-100 hover:text-brand-700 rounded-full text-steel-700"
            >
              {TITLES[e.slug] || e.nombre} ({e.count})
            </a>
          ))}
        </div>
      </section>
    )}

    <div class="mt-8 bg-gradient-to-r from-brand-50 to-brand-100 rounded-xl p-8 text-center">
      <h3 class="text-xl font-semibold text-steel-900 mb-2">¿Tu especialidad no aparece?</h3>
      <p class="text-steel-600 mb-4">Añade tu ficha y la organizamos automáticamente en la categoría correcta.</p>
      <a href="/anadir" class="inline-block px-6 py-3 bg-brand-600 text-white rounded-lg hover:bg-brand-700 font-medium">
        Añadir mi empresa
      </a>
    </div>
  </section>
</Layout>
