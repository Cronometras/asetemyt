---
// Google Analytics with consent gating for ASETEMYT
const GA_ID = 'G-PSB4T9WRJF';
---

<!-- Consent mode default: deny analytics until user consents -->
<script is:inline>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('consent', 'default', {
    'analytics_storage': 'denied'
  });
</script>

<!-- Google tag (gtag.js) -->
<script async src={`https://www.googletagmanager.com/gtag/js?id=${GA_ID}`}></script>
<script define:vars={{ GA_ID }} is:inline>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());
  gtag('config', GA_ID, {
    'send_page_view': false
  });

  // Check saved consent and apply
  const saved = localStorage.getItem('cookie-preferences');
  if (saved) {
    const prefs = JSON.parse(saved);
    if (prefs.analytics) {
      gtag('consent', 'update', { 'analytics_storage': 'granted' });
      gtag('event', 'page_view');
    }
  }
</script>

<!-- Capa de eventos: formularios, CTAs y WhatsApp (Micaot 2026-10-08) -->
<script is:inline>
  document.addEventListener('submit', function (e) {
    try {
      window.gtag && window.gtag('event', 'form_submit', {
        form_id: e.target.id || '(sin-id)',
        form_action: e.target.getAttribute('action') || '(sin-accion)',
        page_path: location.pathname
      });
    } catch (err) {}
  }, true);
  document.addEventListener('click', function (e) {
    try {
      var wa = e.target.closest && e.target.closest('a[href*="wa.me"],a[href*="whatsapp"],a[href*="api.whatsapp"]');
      if (wa) { window.gtag && window.gtag('event', 'whatsapp_click', { page_path: location.pathname }); return; }
      var t = e.target.closest && e.target.closest('a,button');
      if (t) {
        var txt = (t.innerText || '').trim();
        if (txt.length < 80 && /demo|prueba|solicitar|presupuesto|contact|quote|ficha/i.test(txt)) {
          window.gtag && window.gtag('event', 'cta_click', { event_label: txt.slice(0, 60), page_path: location.pathname });
        }
      }
    } catch (err) {}
  }, true);
</script>
